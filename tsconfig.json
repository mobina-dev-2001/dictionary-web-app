{
  "compilerOptions": {
    // ── Language & Environment ────────────────────────────────
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",

    // ── Module System ─────────────────────────────────────────
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowJs": true,

    // ── Type Checking ─────────────────────────────────────────
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // ── Emit ──────────────────────────────────────────────────
    "noEmit": true,
    "incremental": true,

    // ── Next.js ───────────────────────────────────────────────
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },

  // ── File Inclusion ────────────────────────────────────────
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
